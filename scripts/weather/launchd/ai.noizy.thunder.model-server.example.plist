<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THUNDER template: a local model server that answers RSP_001 live (voice replies, DreamChamber).
     It stays at normal priority so replies are fast. Do NOT set ProcessType Background here:
     that moves inference to the efficiency cores and makes every answer slow.
     Batch work on the same models (indexing, embeddings) runs separately, as rain. -->
<plist version="1.0">
<dict>
  <key>Label</key>             <string>ai.noizy.thunder.model-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key>     <string>127.0.0.1:11434</string>
  </dict>
  <key>ProcessType</key>       <string>Standard</string>
  <key>Nice</key>              <integer>5</integer>
  <key>KeepAlive</key>         <true/>
  <key>RunAtLoad</key>         <true/>
  <key>StandardOutPath</key>   <string>/Users/m2ultra/NOIZYBEAST/logs/thunder.model-server.log</string>
  <key>StandardErrorPath</key> <string>/Users/m2ultra/NOIZYBEAST/logs/thunder.model-server.log</string>
</dict>
</plist>
