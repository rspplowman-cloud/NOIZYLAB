# Copy to .env on the Mac. Never commit .env.
# The tunnel token lives in Proton Pass (VAULT-OPS).

# Pinned versions. Checked on Docker Hub 2026-10-24.
N8N_TAG=2.45.3
QDRANT_TAG=v1.20.0
CLOUDFLARED_TAG=2026.10.3
# Forgejo could not be checked from the cloud session (Codeberg was blocked).
# Set the current stable version from https://forgejo.org/releases/ , e.g. a major like 13.
FORGEJO_TAG=

# Public names (routed by the Cloudflare Tunnel).
N8N_PUBLIC_HOST=n8n.noizylab.ca
FORGEJO_PUBLIC_HOST=git.noizylab.ca

# EXISTING data folders. Use the paths your current containers already use,
# so no workflow, vector or repo data is lost.
N8N_DATA_DIR=
QDRANT_DATA_DIR=
FORGEJO_DATA_DIR=

CLOUDFLARE_TUNNEL_TOKEN=
TZ=America/Toronto
