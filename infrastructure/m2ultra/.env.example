# Copy to .env (gitignored). Fill values from Proton Pass — never commit .env.
# Generate secrets on M2ULTRA with:  openssl rand -hex 32

# Where container data lives on M2ULTRA (outside the repo)
NOIZY_DATA=/Users/m2ultra/NOIZY-DATA

# Forgejo
FORGEJO_ROOT_URL=http://localhost:3300/

# n8n — pin an exact version; check https://github.com/n8n-io/n8n/releases
N8N_VERSION=CHANGE_ME
N8N_WORKERS=4
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_DB_PASSWORD=CHANGE_ME
N8N_REDIS_PASSWORD=CHANGE_ME

# HALT (optional until NOI-179 is done). Unreachable = halted.
HALT_URL=
