{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./source",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["source/**/*"],
  "exclude": ["node_modules", "dist"]
}
