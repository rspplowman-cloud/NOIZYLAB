# GABRIEL — environment template
# Copy to .env and fill in values. .env is gitignored.

# ── REQUIRED ──────────────────────────────────────────────────
# Anthropic API key — powers Claude calls (Haiku, Sonnet, Opus)
ANTHROPIC_API_KEY=

# NOIZY Heaven auth — used by heaven-mcp, consent-oracle, engr-keith-mcp.
# Also the daemon's Bearer key: without it the daemon stays on 127.0.0.1 and the
# 6-repo push (/ops/gabriel-sync?mode=push) is refused.
NOIZY_API_KEY=

# HALT kill switch (fails closed: unset or unreachable = halted). Checked by the
# installer, by the push, by DreamChamber and by every automated job.
HALT_URL=

# ── OPTIONAL ──────────────────────────────────────────────────
# File catalog (scripts/catalog/README.md): the 'NOIZY ask key' from Proton Pass, and the n8n ask URL
NOIZY_ASK_KEY=
NOIZY_FILES_ASK_URL=http://127.0.0.1:5678/webhook/noizy-files-ask

# Model routing defaults (overridable per call)
GABRIEL_DEFAULT_MODEL=claude-sonnet-5-5
GABRIEL_FAST_MODEL=claude-haiku-5-5
GABRIEL_HEAVY_MODEL=claude-opus-5-5

# Daemon binding (stays 127.0.0.1; reach it from iPad/iPhone through the Tunnel + Access)
GABRIEL_PORT=9777
GABRIEL_BIND=127.0.0.1
# Web pages served through the Tunnel that may call the daemon (comma-separated origins)
GABRIEL_ALLOWED_ORIGINS=

# Daily spend cap (USD), enforced. Counted from GABRIEL's own receipts; resets at 00:00 UTC.
# At the cap GABRIEL stops calling Claude and says so. "off" removes the cap.
GABRIEL_DAILY_BUDGET_USD=20

# Limits for one turn: seconds before a silent turn is stopped, and tool steps allowed.
GABRIEL_TURN_TIMEOUT_MS=300000
GABRIEL_MAX_TURNS=12

# Tools in chat: GABRIEL's own two servers (knowledge + status, and HEAVEN read-only).
# No shell, no file writes, no web. "off" gives a chat with no tools at all.
# GABRIEL_TOOLS=off

# Voice: "off" silences GABRIEL. The most characters spoken for one reply (the rest stays on screen).
# GABRIEL_VOICE=off
GABRIEL_VOICE_MAX_CHARS=4000

# Where receipts, the cache and the watch list live (shared with gabriel-mcp and lucy-mcp).
# GABRIEL_STATE_DIR=/Users/m2ultra/NOIZYLAB/gabriel-state

# Target date for "days remaining" in the boot greeting. Leave empty for no countdown.
# A date that has passed is reported as passed, never as "0 days".
GABRIEL_TARGET_DATE=
GABRIEL_TARGET_LABEL=

# The 6-repo brand sync script the daemon runs for /ops/gabriel-sync
# GABRIEL_SYNC_SCRIPT=/Users/m2ultra/NOIZYANTHROPIC/ops/gabriel-to-all-brands.sh

# Paths (override only if you move things)
NOIZY_EMPIRE_ROOT=/Users/m2ultra/NOIZYANTHROPIC
GABRIEL_MEMORY_DIR=/Users/m2ultra/.claude/projects/-Users-m2ultra-NOIZYANTHROPIC/memory

# Infomaniak AI Tools (Swiss-hosted open models, used by mcp/infomaniak-mcp). Values in Proton Pass, VAULT-OPS.
INFOMANIAK_TOKEN=
INFOMANIAK_AI_PRODUCT_ID=
# INFOMANIAK_MODEL=
