# GABRIEL — environment template
# Copy to .env and fill in values. .env is gitignored.

# ── REQUIRED ──────────────────────────────────────────────────
# Anthropic API key — powers Claude calls (Haiku, Sonnet, Opus)
ANTHROPIC_API_KEY=

# NOIZY Heaven auth — used by heaven-mcp, consent-oracle, engr-keith-mcp.
# Also the daemon's Bearer key: without it the daemon stays on 127.0.0.1 and the
# 6-repo push (/ops/gabriel-sync?mode=push) is refused.
NOIZY_API_KEY=

# HALT kill switch (fails closed: unset or unreachable = halted). Checked by the
# installer, by the push, by DreamChamber and by every automated job.
HALT_URL=

# ── OPTIONAL ──────────────────────────────────────────────────
# Model routing defaults (overridable per call)
GABRIEL_DEFAULT_MODEL=claude-sonnet-5-5
GABRIEL_FAST_MODEL=claude-haiku-5-5
GABRIEL_HEAVY_MODEL=claude-opus-5-5

# Daemon binding (stays 127.0.0.1; reach it from iPad/iPhone through the Tunnel + Access)
GABRIEL_PORT=9777
GABRIEL_BIND=127.0.0.1
# Web pages served through the Tunnel that may call the daemon (comma-separated origins)
GABRIEL_ALLOWED_ORIGINS=

# Daily spend cap (USD). NOT ENFORCED YET: no code reads this value today.
GABRIEL_DAILY_BUDGET_USD=20

# Target date for "days remaining" math in boot greeting
GABRIEL_TARGET_DATE=2026-05-17
GABRIEL_TARGET_LABEL="noizy.ai fully assembled on Cloudflare"

# Paths (override only if you move things)
NOIZY_EMPIRE_ROOT=/Users/m2ultra/NOIZYANTHROPIC
GABRIEL_MEMORY_DIR=/Users/m2ultra/.claude/projects/-Users-m2ultra-NOIZYANTHROPIC/memory

# Infomaniak AI Tools (Swiss-hosted open models, used by mcp/infomaniak-mcp). Values in Proton Pass, VAULT-OPS.
INFOMANIAK_TOKEN=
INFOMANIAK_AI_PRODUCT_ID=
# INFOMANIAK_MODEL=
